[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Vishnuuss/AI-Voice-Agent-Dashboard.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	vscode-merge-base = origin/main
	merge = refs/heads/main
[branch "billing-and-lead-outcome-fixes"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/billing-and-lead-outcome-fixes
